{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://technehub-labs.github.io/dea-catalog-guardrails/schemas/entity.schema.json",
  "metamodel_version": "1.0.0",
  "title": "Guardrail (catalogue instance schema)",
  "description": "Catalogue-instance projection of the metamodel Guardrail entity. The normative field set is defined by the metamodel schema; this file mirrors it and adds only the catalogue-instance layer (evidence, provenance ladder, governance). Do not widen a normative enum here to accept a value the metamodel does not define: fix the record instead. A catalogue that diverges from the metamodel is a second source of truth.",
  "type": "object",
  "required": [
    "id",
    "type",
    "name",
    "version",
    "lifecycle_status",
    "enforcement",
    "domain"
  ],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^dea:guardrail-[a-z0-9-]+$",
      "description": "OpenDEAM-local identifier, narrowed to this entity's namespace (information-classes id precedent)."
    },
    "type": {
      "type": "string",
      "const": "Guardrail"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "examples": [
        "Approved Cloud Regions Only"
      ]
    },
    "description": {
      "type": "string",
      "maxLength": 2000
    },
    "version": {
      "type": "string"
    },
    "lifecycle_status": {
      "type": "string",
      "enum": [
        "proposed",
        "planned",
        "active",
        "deprecated",
        "retired"
      ],
      "description": "CR-3R: lifecycle state from metamodel/vocabularies/lifecycle.yaml."
    },
    "external_references": {
      "type": "array",
      "description": "CR-3P: identifiers in external systems. Never a substitute for the OpenDEA id (E004).",
      "items": {
        "type": "object",
        "required": [
          "system",
          "identifier"
        ],
        "properties": {
          "system": {
            "type": "string"
          },
          "identifier": {
            "type": "string"
          }
        }
      }
    },
    "enforcement": {
      "type": "string",
      "enum": [
        "advisory",
        "automated-warn",
        "automated-block",
        "platform-enforced"
      ],
      "description": "Enforcement maturity (ADR-0004 D4): advisory = documented recommendation; automated-warn = CI/CD warns; automated-block = CI/CD blocks; platform-enforced = the platform offers no non-compliant path (golden path)."
    },
    "source": {
      "type": "string",
      "maxLength": 100,
      "description": "Originating body or authority for the constraint.",
      "examples": [
        [
          "The Open Group",
          "ISO",
          "NIST",
          "Internal platform team"
        ]
      ]
    },
    "domain": {
      "type": "string",
      "enum": [
        "enterprise-architecture",
        "data-architecture",
        "software-architecture",
        "security-architecture",
        "cloud-architecture",
        "integration-architecture",
        "process-architecture",
        "governance"
      ],
      "description": "Primary domain this guardrail applies to."
    },
    "url": {
      "type": "string",
      "format": "uri",
      "description": "Canonical URL to the guardrail's definition or policy-as-code source."
    },
    "coverage": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Aspects covered: framework, methodology, ontology, notation, etc."
    },
    "relationships": {
      "type": "array",
      "description": "Typed relationship instances asserted by this record (metamodel relationship-instance contract; vendored locally).",
      "items": {
        "$ref": "relationship-instance.schema.json"
      }
    },
    "metadata": {
      "type": "object",
      "description": "Metamodel base-entity metadata.",
      "properties": {
        "created_at": {
          "type": "string"
        },
        "updated_at": {
          "type": "string"
        },
        "created_by": {
          "type": "string"
        },
        "status": {
          "type": "string"
        }
      }
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence": {
      "type": "object",
      "description": "Catalogue-instance layer. The source the record derives from; admission requires at least one source and a rationale.",
      "required": [
        "sources",
        "rationale"
      ],
      "additionalProperties": false,
      "properties": {
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "kind",
              "reference"
            ],
            "additionalProperties": false,
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "repository-path",
                  "system-of-record",
                  "published-document"
                ],
                "description": "Kind of evidence: a path in a technehub-labs repository, an identified system of record, or a published document."
              },
              "reference": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "rationale": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Catalogue-instance layer. Ladder passage from proposal to canonical admission (FOUNDATIONS admission ladder).",
      "required": [
        "ladder_passage"
      ],
      "additionalProperties": false,
      "properties": {
        "ladder_passage": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": [
              "stage",
              "date",
              "actor"
            ],
            "additionalProperties": false,
            "properties": {
              "stage": {
                "type": "string",
                "enum": [
                  "candidate",
                  "corroborated",
                  "reviewed",
                  "canonical"
                ],
                "description": "Admission ladder stages (FOUNDATIONS D-4)."
              },
              "date": {
                "type": "string",
                "description": "ISO date (quoted in YAML so it stays a string)."
              },
              "actor": {
                "type": "string",
                "description": "Authorship-bearing field (AUT rules)."
              }
            }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "description": "Catalogue-instance layer. Ownership and review state.",
      "required": [
        "functional_owner",
        "steward",
        "approval_status"
      ],
      "properties": {
        "functional_owner": {
          "type": "string"
        },
        "steward": {
          "type": "string"
        },
        "approval_status": {
          "type": "string",
          "enum": [
            "proposed",
            "under_review",
            "approved"
          ]
        },
        "review_date": {
          "type": "string"
        },
        "source_and_evidence": {
          "type": "string"
        }
      }
    }
  },
  "metamodel_source": "https://github.com/technehub-labs/dea-metamodel/blob/main/schemas/entities/guardrail.json",
  "additionalProperties": false
}
